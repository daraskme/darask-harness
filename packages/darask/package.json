{
  "name": "dsh-darask",
  "version": "0.1.0-alpha.8",
  "description": "DeepSeek Harness の日本語統合プラグイン。認証・使用量・優先順位、ローカルモデル、GPU 生成・LoRA 学習、Tailscale、Kitesurf、Cloudflare Browser Run、PC 画面の視認と操作。",
  "type": "module",
  "license": "MIT",
  "author": "daraskme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daraskme/dsh-darask.git"
  },
  "homepage": "https://github.com/daraskme/dsh-darask#readme",
  "bugs": {
    "url": "https://github.com/daraskme/dsh-darask/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/client.js",
    "scripts",
    "skills",
    "AGENTS.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs --no-open",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs vendor/dsh-grok-provider/spikes/protocol/test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.85",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.2",
    "@fang2hou/dsh-locale-ja": "0.5.0",
    "ai": "7.0.105",
    "chrome-devtools-mcp": "1.9.0",
    "dsh-bridge-gateway": "file:vendor/dsh-bridge-gateway",
    "dsh-codex-connect": "0.1.0-alpha.4.35",
    "dsh-grok-provider": "file:vendor/dsh-grok-provider",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openrouter",
    "grok",
    "cursor",
    "codex",
    "claude",
    "japanese"
  ],
  "bundledDependencies": [
    "dsh-bridge-gateway",
    "dsh-grok-provider"
  ],
  "bundleDependencies": [
    "dsh-bridge-gateway",
    "dsh-grok-provider"
  ]
}
