{
  "name": "dsh-grok-provider",
  "version": "1.0.5-darask.1",
  "description": "Clean-room Grok Build provider for DeepSeek Harness with official CLI browser authentication",
  "type": "module",
  "license": "MIT",
  "author": "YukiRyou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshino-xiao7/dsh-grok-provider.git"
  },
  "homepage": "https://github.com/yoshino-xiao7/dsh-grok-provider#readme",
  "bugs": {
    "url": "https://github.com/yoshino-xiao7/dsh-grok-provider/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/host/index.mjs"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "grok-provider.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client.js",
    "types",
    "grok-provider.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "DARASK_CHANGES.md"
  ],
  "scripts": {
    "test": "node --test spikes/protocol/test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "sharp": "0.35.4"
  }
}
